# Supabase (Project Settings -> API). Used by browser clients and at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL / reserved and currently unused by the app. SERVER ONLY: never prefix with NEXT_PUBLIC_
# and never import in client code. Only provision for a future privileged integration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL, no trailing slash. Used for metadata, sitemap, robots and OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop WhatsApp number in E.164 digits only: 8-15 digits, no +, spaces or punctuation.
# Fallback only: the live number is edited in the settings row at /admin/settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# SERVER ONLY. Optional salt for the hashed inquiry rate key. Falls back to NEXT_PUBLIC_SITE_URL,
# then "district-wear". Changing this value resets all rate-limit buckets.
INQUIRY_RATE_SALT=change-me-to-a-random-value

# Inquiry logging is toggled in the settings row at /admin/settings, not by an env var.
