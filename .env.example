# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop WhatsApp number in E.164 digits only, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# Optional, server-only salt for the hashed inquiry rate key (never NEXT_PUBLIC_).
# Leave commented to use NEXT_PUBLIC_SITE_URL, then "district-wear". Changing it resets all buckets.
# The feature flag itself lives in the settings row, not in an environment variable.
# INQUIRY_RATE_SALT=
